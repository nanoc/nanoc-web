---
is_hidden: true
---

DirectoryIndex index.html index.php



############################################################
# SECURITY

SetEnvIf Origin "http(s)?://nanoc\.denisdefreyne\.com$" REQUEST_ORIGIN=$0
Header add Access-Control-Allow-Origin %{REQUEST_ORIGIN}e env=REQUEST_ORIGIN
Header add Access-Control-Allow-Credentials "true" env=REQUEST_ORIGIN
Header merge Vary Origin

Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self'; connect-src 'self' https://*.algolia.net https://*.algolianet.com; img-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'self';"

Header set Cross-Origin-Embedder-Policy "credentialless"
Header set Cross-Origin-Opener-Policy "same-origin"



############################################################
# CACHING

Header set Cache-Control "public,max-age=0,must-revalidate"



############################################################
# MIME TYPES

AddType font/woff2                      .woff2



############################################################
# ENCODING

AddDefaultCharset utf-8

AddCharset utf-8 .htm .html .js .css



############################################################
# COMPRESS

# compress - text/html/xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE image/svg+xml
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/xml

# compress - css
AddOutputFilterByType DEFLATE text/css

# compress - js
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE text/javascript



############################################################
# ERROR DOCUMENT

ErrorDocument 404 /404.html



############################################################
# REDIRECTS

RewriteEngine On

RewriteCond %{HTTP_HOST} ^nanoc\.stoneship\.org$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(?:www\.)?nanoc\.ws$ [NC,OR]
RewriteCond %{HTTP_HOST} ^(?:www\.)?nanoc\.app$ [NC]
RewriteRule ^(.*)$ https://nanoc.denisdefreyne.com/$1 [R=301,L,NE]

RewriteRule ^doc/?$                                   /about/                             [R=301,L]
RewriteRule ^docs/basics/?$                           /doc/tutorial/                      [R=301,L]
RewriteRule ^docs/troubleshooting/?$                  /doc/troubleshooting/               [R=301,L]
RewriteRule ^docs/api/Nanoc/Filters.html$             /doc/reference/filters/             [R=301,L]
RewriteRule ^docs/api/Nanoc/Helpers/XMLSitemap.html$  /doc/reference/helpers/#xmlsitemap  [R=301,L]
RewriteRule ^docs/reference/helpers/?$                /doc/reference/helpers/             [R=301,L]
RewriteRule ^release-notes/details/?$                 /release-notes/                     [R=301,L]
RewriteRule ^docs/api/Nanoc/Helpers/Rendering.html$   /doc/reference/helpers/#rendering   [R=301,L]
